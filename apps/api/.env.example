DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus_marine?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=4000
# Virgülle ayrılmış izinli origin listesi (web dashboard / portal)
CORS_ORIGINS="http://localhost:5173"
STORAGE_DIR="./storage"
# Expo push bildirimlerini gönder (true/false)
EXPO_PUSH_ENABLED=false
# Zamanlanmış görevler (gecikme, yaklaşan bakım) aralığı (dakika)
SCHEDULER_INTERVAL_MIN=60
