{
  "expo": {
    "name": "Nexus Marine",
    "slug": "nexus-marine",
    "scheme": "nexusmarine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2342"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexusmarine.operations",
      "infoPlist": {
        "NSCameraUsageDescription": "İş emirlerine ve denetimlere fotoğraf eklemek için kamera erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Galeriden fotoğraf seçmek için erişim gerekir."
      }
    },
    "android": {
      "package": "com.nexusmarine.operations",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B2342"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "İş emirlerine fotoğraf eklemek için kamera erişimi gerekir."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1767AD"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000",
      "eas": {
        "projectId": ""
      }
    }
  }
}
